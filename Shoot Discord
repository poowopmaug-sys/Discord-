@bot.tree.command(name="ip", description="check ip")
async def ip_lookup(interaction: discord.Interaction, ip_address: str):
    await interaction.response.defer(ephemeral=True)

    url = f"http://ip-api.com/json/{ip_address}?fields=66846719"
    response = requests.get(url)
    data = response.json()

    if data["status"] != "success":
        await interaction.followup.send(f"# ไม่พบข้อมูล IP {ip_address} มึงใส่ให้ถูกดิไอควายย เช่น 45.141.27.118")
        return

    lat = data.get('lat', 0)
    lon = data.get('lon', 0)
    maps_url = f"https://www.google.com/maps?q={lat},{lon}"

    embed = discord.Embed(
        title=f"มึงเช็ค IP นี่ {ip_address}",
        color=discord.Color.dark_grey()
    )
    embed.add_field(name="`ประเทศ`", value=f"{data.get('country', 'N/A')} ({data.get('countryCode', 'N/A')})", inline=True)
    embed.add_field(name="`เมือง`", value=data.get('city', 'N/A'), inline=True)
    embed.add_field(name="`ภูมิภาค`", value=data.get('regionName', 'N/A'), inline=True)
    embed.add_field(name="`ISP`", value=data.get('isp', 'N/A'), inline=True)
    embed.add_field(name="`องค์กร`", value=data.get('org', 'N/A'), inline=True)
    embed.add_field(name="`ASN`", value=data.get('as', 'N/A'), inline=True)
    embed.add_field(name="`พิกัด`", value=f"{lat}, {lon}", inline=True)
    embed.add_field(name="`ลิงก์แผนที่`", value=f"[เปิดดูแผนที่]({maps_url})", inline=True)
    embed.add_field(name="`Timezone`", value=data.get('timezone', 'N/A'), inline=True)
    embed.add_field(name="`Proxy / VPN`", value="ใช่" if data.get('proxy', False) else "ไม่ใช่", inline=True)
    embed.set_image(url="https://cdn.discordapp.com/attachments/1350862294309011476/1379142447153811697/7d33c243485aa0dd8dd0d6ad5d0215db.gif")
    embed.set_footer(
        text="© 2025 COPYRIGH 𝑪𝒂𝒕 𝑩𝒐𝒔𝒔 ALL RIGHTS RESERVED",
        icon_url=bot.user.avatar.url if bot.user.avatar else None
    )

    await interaction.followup.send(embed=embed)

@bot.tree.command(name="check", description="check Bangkok")
async def check(interaction: discord.Interaction, city: str):
    if await is_banned(interaction):
        return

    city = city.title()
    if city not in THAI_CITIES:
        await interaction.response.send_message("# ใส่ Bangkok, Chiang Mai, Khon Kaen, Phuket, Nakhon Ratchasima,Udon Thani, Hat Yai, Pattaya, Rayong, Surat Thani เลือกมา1 อัน", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)

    url = f"http://api.openweathermap.org/data/2.5/weather?q={city},TH&appid={api}&units=metric&lang=th"
    async with aiohttp.ClientSession() as session:
        async with session.get(url) as resp:
            if resp.status != 200:
                await interaction.followup.send("# ตอนนี้ระบบกำลังแก้ รอแปป", ephemeral=True)
                return
            data = await resp.json()

    temp = data["main"]["temp"]
    humidity = data["main"]["humidity"]
    pressure = data["main"]["pressure"]
    wind_speed = data["wind"]["speed"]
    wind_deg = data["wind"].get("deg", 0)

    cape = random.randint(0, 3000)
    wind_shear = random.uniform(0, 30)
    supercell_risk = cape > 1500 and wind_shear > 20
    supercell_status = "`มีความเสี่ยงเกิด พายุ`" if supercell_risk else "`ไม่มีการพบการเกิด/ใกล้เคียง`"

    embed = discord.Embed(
        title=f"Check `{city}` >> Bangkok <<",
        description="`https://discord.gg/nrmRVzY4`\n`𝑪𝒂𝒕 𝑩𝒐𝒔𝒔`",
        color=0x00bfff
    )
    embed.add_field(name="อุณหภูมิ", value=f"`{temp} °C`", inline=True)
    embed.add_field(name="ความชื้น", value=f"`{humidity} %`", inline=True)
    embed.add_field(name="ความเร็วลม", value=f"`{wind_speed} m/s ({wind_deg}°)`", inline=True)
    embed.add_field(name="ความกดอากาศ", value=f"`{pressure} hPa`", inline=True)
    embed.add_field(name="เคป", value=f"`{cape} J/kg`", inline=True)
    embed.add_field(name="ลมเฉือน", value=f"`{wind_shear:.2f} m/s`", inline=True)
    embed.add_field(name="ซูเปอร์เซลล์", value=supercell_status, inline=False)
    embed.set_image(url="https://cdn.discordapp.com/attachments/1350862294309011476/1379142447153811697/7d33c243485aa0dd8dd0d6ad5d0215db.gif")
    embed.set_footer(
        text="© 2025 COPYRIGH 𝑪𝒂𝒕 𝑩𝒐𝒔𝒔 ALL RIGHTS RESERVED",
        icon_url=bot.user.avatar.url if bot.user.avatar else None
    )

    await interaction.followup.send(embed=embed)

@bot.tree.command(name="serverdiscord", description="info")
async def serverdiscord(interaction: discord.Interaction, server_id: str):
    guild = discord.utils.get(bot.guilds, id=int(server_id))
    if await is_banned(interaction):
        return

    await interaction.response.defer(ephemeral=True)

    if guild is None:
        await interaction.followup.send("# ID ผิด หรือไม่มีว่ะ", ephemeral=True)
        return

    online = idle = dnd = offline = bots = 0

    async for member in guild.fetch_members(limit=None):
        if member.bot:
            bots += 1
            continue
        match member.status:
            case discord.Status.online:
                online += 1
            case discord.Status.idle:
                idle += 1
            case discord.Status.dnd:
                dnd += 1
            case discord.Status.offline:
                offline += 1

    embed = discord.Embed(
        title=f"🔓 SERVER ที่มึงแฮก: {guild.name}",
        color=discord.Color.dark_gray()
    )
    embed.set_thumbnail(url=guild.icon.url if guild.icon else discord.Embed.Empty)
    embed.add_field(name="ชื่อดิส", value=guild.name, inline=False)
    embed.add_field(name="Server ID", value=guild.id, inline=False)
    embed.add_field(name="คนสร้างดิส", value=f"{guild.owner} ({guild.owner_id})", inline=False)
    embed.add_field(name="รวมคน", value=guild.member_count, inline=True)
    embed.add_field(
        name="ออนกี่",
        value=(
            f"ออนไลน์: {online}\n"
            f"หายตัว: {idle}\n"
            f"ห้ามรบกวน: {dnd}\n"
            f"ออฟไลน์: {offline}\n"
            f"บอท: {bots}"
        ),
        inline=True
    )
    embed.add_field(name="สร้างเมื่อ", value=guild.created_at.strftime("%d/%m/%Y %H:%M:%S"), inline=True)
    embed.add_field(name="ภูมิภาคเสียง", value=str(guild.preferred_locale).upper(), inline=True)
    embed.add_field(name="ช่องข้อความ", value=len([c for c in guild.channels if isinstance(c, discord.TextChannel)]), inline=True)
    embed.add_field(name="ช่องเสียง", value=len([c for c in guild.channels if isinstance(c, discord.VoiceChannel)]), inline=True)
    embed.add_field(name="หมวดหมู่", value=len(guild.categories), inline=True)
    embed.add_field(name="จำนวน Roles", value=len(guild.roles), inline=True)
    embed.set_image(url="https://cdn.discordapp.com/attachments/1350862294309011476/1379142447153811697/7d33c243485aa0dd8dd0d6ad5d0215db.gif")
    embed.set_footer(
        text="© 2025 COPYRIGH 𝑪𝒂𝒕 𝑩𝒐𝒔𝒔 ALL RIGHTS RESERVED",
        icon_url=bot.user.avatar.url if bot.user.avatar else None
    )

    await interaction.followup.send(embed=embed, ephemeral=True)

