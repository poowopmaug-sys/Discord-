def generate_fake_token():
    uid = ''.join(random.choices(string.digits, k=18))
    part1 = base64.b64encode(uid.encode()).decode().replace("=", "") # base64 ของ user_id
    part2 = ''.join(random.choices(string.ascii_letters + string.digits, k=6)) # ประมาณกลาง token
    part3 = ''.join(random.choices(string.ascii_letters + string.digits + "_-", k=27)) # ปลาย token
    return f"{part1}.{part2}.{part3}"

