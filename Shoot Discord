@bot.tree.command(name="pingbot", description="xeecida")
async def pingbot(interaction: discord.Interaction):
    if await is_banned(interaction):
        return

    start_time = time.time()
    await interaction.response.defer(ephemeral=True)
    end_time = time.time()

    latency_ms = round((end_time - start_time) * 1000)
    cpu = platform.processor()
    system = platform.system()
    release = platform.release()
    ram = psutil.virtual_memory().total / (1024 ** 3)
    ram_used = psutil.virtual_memory().used / (1024 ** 3)
    cpu_usage = psutil.cpu_percent(interval=1)

    embed = discord.Embed(
        title="BOT STATUS",
        color=discord.Color.blue()
    )
    embed.add_field(name="`📶` Pingbot", value=f"`[{latency_ms}] ms`", inline=False)
    embed.add_field(name="`🖥️` ระบบที่รัน", value=f"[{system} {release}]", inline=True)
    embed.add_field(name="`⚙️` CPU", value=cpu or "[ไม่ระบุ]", inline=True)
    embed.add_field(name="`🔥` การใช้ CPU", value=f"[{cpu_usage}]%", inline=True)
    embed.add_field(name="`💾` RAM", value=f"[{ram_used:.2f}] / [{ram:.2f}] GB", inline=True)
    embed.add_field(name="`👑` DEV", value="`[Drak]`", inline=False)
    embed.set_footer(text="© 2025 COPYRIGH 𝑪𝒂𝒕 𝑩𝒐𝒔𝒔 ALL RIGHTS RESERVED", icon_url=bot.user.avatar.url if bot.user.avatar else None)

